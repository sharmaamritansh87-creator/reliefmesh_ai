# --- Optional LLM (ASI:One or any OpenAI-compatible API). Leave empty to use rule-based parsing. ---
LLM_API_KEY=
LLM_BASE_URL=https://api.asi1.ai/v1
LLM_MODEL=asi1-mini

# --- Agents (change seeds for real deployments; addresses derive from seeds) ---
INTAKE_SEED=
VERIFICATION_SEED=
RESOURCE_SEED=
ROUTING_SEED=
COORDINATOR_SEED=
# MAILBOX=1 -> connect an agent to Agentverse via mailbox when running it standalone
MAILBOX=0

# --- Region config folder (copy ./data to add Odisha / Kerala / Bihar ...) ---
# RELIEF_DATA_DIR=./data
API_PORT=8080
